---
extends: default
rules:
  line-length: disable
  comments-indentation: disable
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
ignore: |
  tests/out/
  vars/local*.yml
  inventory/local*.yml
