# Execution environment for the FlashArray job templates, built directly on
# the supported image when ansible-builder is not available or misbehaves:
#
#   podman build -f aap/Containerfile.ee -t localhost/flasharray-eda-ee:latest .
#
# Same content as aap/execution-environment.yml: py-pure-client and the
# everpure.flasharray collection on top of ee-supported-rhel9.
ARG EE_BASE_IMAGE=registry.redhat.io/ansible-automation-platform-27/ee-supported-rhel9:latest
FROM $EE_BASE_IMAGE
USER root
COPY requirements.txt /tmp/requirements.txt
COPY requirements.yml /tmp/requirements.yml
RUN /usr/bin/python3 -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && ANSIBLE_GALAXY_DISABLE_GPG_VERIFY=1 ansible-galaxy collection install -r /tmp/requirements.yml \
       --collections-path /usr/share/ansible/collections \
    && rm -f /tmp/requirements.txt /tmp/requirements.yml
USER 1000
